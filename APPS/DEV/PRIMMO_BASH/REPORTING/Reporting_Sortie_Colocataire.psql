-- LIP / Window Functions		
SELECT 
	id,
	nom,
	prenom, 
	test.total_loyer_payes_hc_a_date( id )::money AS "Total Loyers Payés",
	loyer_mensuel_hc,
	ntile( 16 ) OVER ( PARTITION BY loyer_mensuel_hc ORDER BY id ),
	row_number() OVER ( PARTITION BY loyer_mensuel_hc ORDER BY id ),
	rank() OVER ( PARTITION BY loyer_mensuel_hc ORDER BY id ),
	dense_rank() OVER ( PARTITION BY loyer_mensuel_hc ORDER BY id ),
	percent_rank() OVER ( PARTITION BY loyer_mensuel_hc ORDER BY id ),
	cume_dist() OVER ( PARTITION BY loyer_mensuel_hc ORDER BY id )
FROM
	test.locataire;
	


