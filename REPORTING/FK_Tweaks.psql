CREATE TABLE IF NOT EXISTS REFERENCED_1 (
  id integer generated by default as identity primary key,
  libre TEXT NULL,
);
CREATE TABLE IF NOT EXISTS REFERENCED_2 (
  id integer generated by default as identity primary key,
  libre TEXT NULL,
);
CREATE TABLE IF NOT EXISTS REFERENCED_3 (
  id integer generated by default as identity primary key,
  libre TEXT NULL,
);
CREATE TABLE IF NOT EXISTS REFERENCED_4 (
  id integer generated by default as identity primary key,
  libre TEXT NULL,
);

-- multi FK  check 
CREATE TABLE IF NOT EXISTS REFERENCING_1 (
  id integer generated by default as identity primary key,
  id_referenced_1 integer REFERENCES referenced_1 ON DELETE SET NULL ON UPDATE CASCADE,
  id_referenced_2 integer REFERENCES referenced_2 ON DELETE SET NULL ON UPDATE CASCADE,
  id_referenced_3 integer REFERENCES referenced_3 ON DELETE SET NULL ON UPDATE CASCADE,
  id_referenced_4 integer REFERENCES referenced_4 ON DELETE SET NULL ON UPDATE CASCADE,
  libre TEXT NULL,
  EXCLUDE USING gist (
    numero_chambre WITH =,
    periode_occupation WITH &&
  )
);